<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightblue">


    <ImageView
        android:id="@+id/requestPhoto"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="68dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <Button
        android:id="@+id/editProfilePhotoButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Profile Photo"
        app:layout_constraintTop_toBottomOf="@+id/requestPhoto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />
    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/requestPhoto"
        android:layout_marginTop="92dp"
        android:alignmentMode="alignMargins"
        android:columnCount="2"
        android:columnOrderPreserved="false"
        android:padding="16dp"
        android:rowCount="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/requestPhoto"
        tools:ignore="MissingConstraints">

        <!-- Name Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name : "
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Name Value -->
        <TextView
            android:id="@+id/nameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="John Doe"
            android:textColor="@android:color/black"
            android:textSize="18sp" />
        <!-- Gender label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:color="@color/black"
            android:text="Type :"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Gender Value -->
        <TextView
            android:id="@+id/typeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="gender"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Country :"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- Email Value -->
        <TextView
            android:id="@+id/countryText1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="johndoe@example.com"
            android:textColor="@android:color/black"
            android:textSize="18sp"/>
        <!-- Birthdate Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description :"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Birthdate Value -->
        <TextView
            android:id="@+id/descriptionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+1234567890"
            android:textColor="@android:color/black"
            android:textSize="18sp"/>
        <!-- Email Label -->

        <!-- Password Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Poster :"
            android:id="@+id/posterLabel"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Password Value -->
        <TextView
            android:id="@+id/posterText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="***********"
            android:textColor="@android:color/black"
            android:textSize="18sp" />
        <!-- Phone Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Posting time :"
            android:id="@+id/postingTimeLabel"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- Phone Value -->
        <TextView
            android:id="@+id/postingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+1234567890"
            android:textColor="@android:color/black"
            android:textSize="18sp" />
        <!-- Phone Label -->
        <!-- Phone Label -->


    </GridLayout>

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/gridLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- First Row -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/editRequest"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="55dp"
                android:text="Edit request" />
            <Button
                android:id="@+id/Decline"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="55dp"
                android:text="Decline" />
        </TableRow>
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/Accept"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="55dp"
                android:text="Accept" />
            <Button
                android:id="@+id/declineAndBan"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="55dp"
                android:text="Decline and ban" />
        </TableRow>

        <!-- Second Row -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>

    </TableLayout>


    <LinearLayout
        android:id="@+id/iconLayout"
        android:layout_width="0dp"

        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/articles"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:background="@drawable/currentborder"
            android:src="@drawable/articlesselected" />

        <ImageView
            android:id="@+id/forum"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/border"
            android:src="@drawable/forum" />

        <ImageView
            android:id="@+id/dashboard"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/border"
            android:src="@drawable/dashboard" />

        <ImageView
            android:id="@+id/settings"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/border"
            android:src="@drawable/settings" />

        <ImageView
            android:id="@+id/profile"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/border"
            android:src="@drawable/profile" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
