<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightblue">

    <!-- Profile Details Grid -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/iconLayout"
        app:layout_constraintBottom_toTopOf="@id/iconLayout">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/requestPhoto"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="44dp"
                android:scaleType="centerCrop" />

            <!-- Edit Profile Photo Button -->
            <Button
                android:id="@+id/editProfilePhotoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Edit Profile Photo" />




            <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/requestPhoto"
        android:layout_marginTop="72dp"
        android:alignmentMode="alignMargins"
        android:columnCount="2"
        android:columnOrderPreserved="false"
        android:padding="16dp"
        android:rowCount="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/requestPhoto"
        tools:ignore="MissingConstraints">

        <!-- Name Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="First name :"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:textStyle="bold"  />

        <!-- Name Value -->
        <EditText
            android:id="@+id/nameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="John Doe"
            android:textColor="@android:color/black"
            android:textSize="18sp" />
                <!-- Last Name Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last name :"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />
                <!-- Name Value -->
                <EditText
                    android:id="@+id/textLastName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="John Doe"
                    android:textColor="@android:color/black"
                    android:textSize="18sp" />
        <!-- Gender label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                android:text="Gender:"
                android:textSize="18sp"
                android:textColor="@android:color/black"
                android:textStyle="bold" />
            <!-- Gender Value -->
                    <Spinner
                        android:id="@+id/gender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@android:color/black"/>
            <!-- Birthdate Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Birth Date:"
                android:textSize="18sp"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

        <!-- Birthdate Value -->
        <EditText
            android:id="@+id/descriptionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+1234567890"
            android:textColor="@android:color/black"
            android:textSize="18sp" />
        <!-- Email Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email:"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

        <!-- Email Value -->
        <EditText
            android:id="@+id/countryText1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="johndoe@example.com"
            android:textColor="@android:color/black"
            android:textSize="18sp" />
        <!-- Old Password Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Old password :"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

        <!-- Old Password Value -->
        <EditText
            android:id="@+id/oldpasswordText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@android:color/black"
            android:textSize="18sp" />
                <!-- New Password Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New password :"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />

                <!-- Password Value -->
                <EditText
                    android:id="@+id/newPasswordText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@android:color/black"
                    android:textSize="18sp" />
        <!-- New Password Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm password :"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

        <!-- Password Value -->
        <EditText
            android:id="@+id/ConfirmPasswordText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@android:color/black"
            android:textSize="18sp" />
        <!-- Phone Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone:"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

        <!-- Phone Value -->
        <EditText
            android:id="@+id/postingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+1234567890"
            android:textColor="@android:color/black"
            android:textSize="18sp" />
        <!-- Country Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Country:"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

        <!-- Country Value -->
                <Spinner
                    android:id="@+id/country"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"

                    android:layout_marginTop="5dp"
                    android:textColor="@android:color/black"
                    />
        <!-- Security Question label Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Security Question :"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />
                <Spinner
                    android:id="@+id/securityQuestionSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@android:color/black"
                    />
                <!-- Security Question answer Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Security question answer :"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />

                <!-- Phone Value -->
                <EditText
                    android:id="@+id/securityQuestionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+1234567890"
                    android:textColor="@android:color/black"
                    android:textSize="18sp" />

            </GridLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="200dp"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/submitButton1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Submit" />

                <Button
                    android:id="@+id/skipButton2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Skip" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>



    <LinearLayout
        android:id="@+id/iconLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/articles"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:background="@drawable/border"
            android:src="@drawable/articles" />

        <ImageView
            android:id="@+id/forum"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/border"
            android:src="@drawable/forum" />

        <ImageView
            android:id="@+id/dashboard"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/border"
            android:src="@drawable/dashboard" />

        <ImageView
            android:id="@+id/settings"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/border"
            android:src="@drawable/settings" />

        <ImageView
            android:id="@+id/profile"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/currentborder"
            android:src="@drawable/profileselected" />

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
