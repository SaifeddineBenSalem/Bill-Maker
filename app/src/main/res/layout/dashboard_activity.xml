<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightblue">


    <LinearLayout
        android:id="@+id/iconLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/articles"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:background="@drawable/border"
            android:src="@drawable/articles" />

        <ImageView
            android:id="@+id/forum"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/border"
            android:src="@drawable/forum" />

        <ImageView
            android:id="@+id/dashboard"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/currentborder"
            android:src="@drawable/dashboardselected" />

        <ImageView
            android:id="@+id/settings"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/border"
            android:src="@drawable/settings" />

        <ImageView
            android:id="@+id/profile"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/border"
            android:src="@drawable/profile" />
    </LinearLayout>


    <View
        android:id="@+id/view"
        android:layout_width="361dp"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/box_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.49"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </View>

    <View
        android:id="@+id/pendingRequests"
        android:layout_width="202dp"
        android:layout_height="94dp"
        android:layout_marginTop="152dp"
        android:background="@drawable/box_background1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.617"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </View>

    <TextView
        android:id="@+id/pendingRequestsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="x"
        android:textColor="#333333"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginLeft="55dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.425"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view"
        app:layout_constraintVertical_bias="0.091" />

    <View
        android:id="@+id/listOfUsers"
        android:layout_width="196dp"
        android:layout_height="83dp"
        android:layout_marginTop="296dp"
        android:background="@drawable/box_background2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </View>

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="82dp"
        android:gravity="center"
        android:padding="12dp"
        android:text="Change logs : Version 1.0.0\nClick to view updates."
        android:textColor="#333333"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/pendingRequestsText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/addRequestButton"
        android:layout_width="80dp"
        android:layout_height="87dp"
        android:layout_marginBottom="60dp"
        android:src="@drawable/plusbutton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/listOfUsersText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="List of users"
        android:textColor="#333333"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.58"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view"
        app:layout_constraintVertical_bias="0.368" />


</androidx.constraintlayout.widget.ConstraintLayout>
